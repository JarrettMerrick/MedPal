# ============================================================
# MedPal 版本库排除清单
# ------------------------------------------------------------
# 三条原则：
#   ① 密钥 / 证书 / 运行数据绝不入库 —— 一旦提交，Git 历史无法彻底清除；
#   ② 目录类规则尽量锚定根目录（/data/、/logs/），避免误伤同名源码目录
#      （曾发生 data/ 把 frontend/src/pages/data/ 整个页面静默排除的事故）；
#   ③ 只有"绝不可能出现在源码里"的名字（node_modules、__pycache__）才全局匹配。
# ============================================================

# ---------- 1. 密钥与证书（最高优先级，任何情况不得入库） ----------
.env
.env.*
# 脱敏模板允许入库（不含任何真实密钥）
!.env.example

# HTTPS 证书、SSH / PuTTY 私钥：由部署机持有，不随仓库分发
*.pem
*.key
*.crt
*.cer
*.der
*.pfx
*.p12
*.ppk

# ---------- 2. 运行时数据（程序自动生成，禁止入库） ----------
# 锚定根目录：数据统一存放在 <项目根>/data（容器内为挂载卷 /app/data）
/data/
/logs/
/temp_exports/

# SQLite 数据库及其 WAL / SHM / 回滚日志
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# 运行与访问日志（按天轮转）
*.log

# ---------- 3. 生产部署与内部资料（有意不入库，请勿删除本段） ----------
# 部署脚本、证书挂载路径、域名等生产细节只在部署机上保留，不随仓库分发
/deploy/
# 安全审计报告：含尚未修复的问题细节，入库等同于公开攻击线索
/docs/audit/
# 本地开发说明文档
/api接口开发说明.md

# ---------- 4. 本地覆盖配置 ----------
# Docker Compose 约定的本地覆盖文件（常写本机端口 / 证书路径 / 数据目录）；
# docker-compose.yml 本身必须入库，故只忽略 override 版本
docker-compose.override.yml
docker-compose.override.yaml

# ---------- 5. Python（后端） ----------
__pycache__/
*.py[cod]
*.so
*.egg-info/

# 虚拟环境（覆盖「仓库根目录」与「backend/」两种常见位置）
/.venv/
/venv/
/env/
/ENV/
/backend/.venv/
/backend/venv/
/backend/env/
/backend/ENV/

# 构建产物（锚定根目录：避免误伤 src/lib、src/build 一类源码目录）
/build/
/dist/

# 测试与静态检查缓存
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/

# ---------- 6. Node / 前端 ----------
# node_modules 绝不可能包含源码，保持全局匹配（含子目录）
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ---------- 7. 打包与发布产物 ----------
*.tar
*.tar.gz
*.tgz
*.zip
*.whl
# 界面截图回归产物（frontend/scripts/screenshot-regression.mjs 的输出目录）
.screenshots/

# ---------- 8. 编辑器 / IDE / 工具数据 ----------
# CodeBuddy 项目数据（非源码）
.codebuddy/
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db
desktop.ini

# ---------- 9. 其他临时文件 ----------
*.bak
*.tmp
*.temp
~$*
