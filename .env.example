# ============================================================
# MedPal 环境变量示例
# ------------------------------------------------------------
# 使用方式：复制本文件为 .env 后按需修改（.env 不会被提交到版本库）
#     cp .env.example .env
#
# 【必改项】SECRET_KEY —— 应用启动时会强制校验，
#   若仍为代码内置公开默认值将**拒绝启动**。生成方式：
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================================

# ---------- 基础 ----------
APP_NAME=MedPal信息管理系统
# development（本地开发，日志更详细） / production（生产）
ENVIRONMENT=development

# JWT 签名密钥（必填，必须替换为随机值）
# [安全修复 2026-09-16] 此处必须是**代码内置的公开占位符**：直接复制本文件后应用会
# 拒绝启动，强制使用者先生成真实随机密钥，避免"照抄示例里的密钥直接上线"——
# 示例文件是公开的，若用它当生产密钥，任何人都能伪造登录令牌。
SECRET_KEY=your-secret-key-change-in-production-2024

# ---------- 数据存储 ----------
# 数据根目录（数据库 / 上传 / 备份 / 日志统一存放处）
# 留空则自动检测：源码布局 = 项目根 data/；容器布局 = /app/data
#DATA_ROOT=

# 数据库连接串（留空则使用 ${DATA_ROOT}/medical.db）
#DATABASE_URL=sqlite:///./data/medical.db

# SQLite WAL 模式：Linux 生产建议 true；
# Windows Docker Desktop 挂载 NTFS 卷时会出现 disk I/O error，需设为 false
SQLITE_WAL_ENABLED=true

# ---------- 跨域 ----------
# 允许的跨域来源，逗号分隔。本地开发需包含前端地址
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 令牌有效期 ----------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=3

# ---------- 文件上传 ----------
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp

# ---------- 备份 ----------
BACKUP_ENABLED=true
# 最大备份保留数量（等于保留天数），每日北京时间 00:15 自动备份
BACKUP_MAX_COUNT=7

# ---------- 日志 ----------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- 新建账号初始口令（兼容保留） ----------
# 说明：新建账号口令现由「系统设置 → 账号设置」中的口令模板生成
#      （默认 MedPal@2026，支持 {工号} 占位符，可在界面调整）。
#      本变量仅用于兼容历史配置，通常无需设置。
#DEFAULT_PASSWORD=MedPal@2026
